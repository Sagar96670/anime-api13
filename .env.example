# Blogger public blog ID (numeric ID or blog identifier accepted by Blogger API v3)
BLOGGER_BLOG_ID=

# Public Blogger JSON Feed URL, e.g. https://your-blog.blogspot.com/feeds/posts/default?alt=json
BLOGGER_FEED_URL=

# Optional API key for reading via Blogger API v3 if no feed URL is supplied
BLOGGER_API_KEY=

# OAuth 2.0 credentials for writing/updating posts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Protect manual sync requests. Use a long random value.
SYNC_SECRET=

# Vercel Cron automatically sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Warm-instance catalog cache in milliseconds (default: 60000)
BLOGGER_CACHE_TTL_MS=60000
